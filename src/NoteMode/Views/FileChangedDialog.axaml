<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NoteMode.Views.FileChangedDialog"
        Title="File Changed"
        Width="450"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <DockPanel Margin="16">
        <!-- Enter, Escape and the window's X all keep the user's edits; only an explicit click on
             Reload throws them away. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="Reload and Discard My Changes" Click="Reload_Click"/>
            <Button Content="Keep My Changes" Click="KeepChanges_Click" Classes="primary" IsDefault="True" IsCancel="True"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Spacing="8">
            <TextBlock x:Name="MessageText"
                       Text="The file has been modified outside of NoteMode."
                       TextWrapping="Wrap"/>
            <TextBlock Text="You have unsaved changes in NoteMode."
                       Foreground="{DynamicResource WarningColor}"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </DockPanel>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer tool: renders NoteMode's windows with Avalonia's headless platform (works on any OS)
       and writes PNGs: UI previews, the README / Store marketing screenshots and the MSIX logo assets. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The referenced app is Native AOT; this tool is a normal JIT build. -->
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <!-- Bundled font so the marketing text looks the same on every OS -->
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NoteMode\NoteMode.csproj" />
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 desktop rescap">

  <!-- Identity values come from Partner Center (Product identity page) once the name is reserved.
       Build-Msix.ps1 substitutes the placeholders; the defaults let a local sideload build work. -->
  <Identity
    Name="__PACKAGE_NAME__"
    Publisher="__PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>NoteMode</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A lightweight, fast text editor that remembers your session.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="NoteMode" Executable="NoteMode.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="NoteMode"
        Description="A lightweight, fast text editor that remembers your session: tabs, unsaved changes and all."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- "notemode file.txt" from a terminal. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="NoteMode.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="notemode.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>

        <!-- Offered under "Open with" and in Settings > Default apps. The packaged app cannot write
             the per-user associations the Settings dialog makes, so it declares them here instead. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="notemodetext">
            <uap:DisplayName>Text file</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.txt</uap:FileType>
              <uap:FileType>.log</uap:FileType>
              <uap:FileType>.md</uap:FileType>
              <uap:FileType>.markdown</uap:FileType>
              <uap:FileType>.rst</uap:FileType>
              <uap:FileType>.csv</uap:FileType>
              <uap:FileType>.tsv</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="notemodeconfig">
            <uap:DisplayName>Config file</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.json</uap:FileType>
              <uap:FileType>.xml</uap:FileType>
              <uap:FileType>.yaml</uap:FileType>
              <uap:FileType>.yml</uap:FileType>
              <uap:FileType>.toml</uap:FileType>
              <uap:FileType>.ini</uap:FileType>
              <uap:FileType>.cfg</uap:FileType>
              <uap:FileType>.conf</uap:FileType>
              <uap:FileType>.env</uap:FileType>
              <uap:FileType>.properties</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="notemodeweb">
            <uap:DisplayName>Web file</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.html</uap:FileType>
              <uap:FileType>.htm</uap:FileType>
              <uap:FileType>.css</uap:FileType>
              <uap:FileType>.scss</uap:FileType>
              <uap:FileType>.sass</uap:FileType>
              <uap:FileType>.less</uap:FileType>
              <uap:FileType>.svg</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="notemodecode">
            <uap:DisplayName>Source file</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.cs</uap:FileType>
              <uap:FileType>.java</uap:FileType>
              <uap:FileType>.py</uap:FileType>
              <uap:FileType>.ts</uap:FileType>
              <uap:FileType>.jsx</uap:FileType>
              <uap:FileType>.tsx</uap:FileType>
              <uap:FileType>.c</uap:FileType>
              <uap:FileType>.cpp</uap:FileType>
              <uap:FileType>.h</uap:FileType>
              <uap:FileType>.hpp</uap:FileType>
              <uap:FileType>.go</uap:FileType>
              <uap:FileType>.rs</uap:FileType>
              <uap:FileType>.rb</uap:FileType>
              <uap:FileType>.php</uap:FileType>
              <uap:FileType>.swift</uap:FileType>
              <uap:FileType>.kt</uap:FileType>
              <uap:FileType>.scala</uap:FileType>
              <uap:FileType>.fs</uap:FileType>
              <uap:FileType>.fsx</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="notemodescript">
            <uap:DisplayName>Script</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.sh</uap:FileType>
              <uap:FileType>.bash</uap:FileType>
              <uap:FileType>.lua</uap:FileType>
              <uap:FileType>.pl</uap:FileType>
              <uap:FileType>.r</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="notemodedata">
            <uap:DisplayName>Data file</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.sql</uap:FileType>
              <uap:FileType>.graphql</uap:FileType>
              <uap:FileType>.proto</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Win32 desktop app: reads and writes whatever files the user opens. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
